{
    "name": "babdev/websocket-server",
    "type": "library",
    "description": "PHP library to create a WebSocket server",
    "keywords": [
        "WAMP",
        "websocket",
        "websocket server"
    ],
    "license": "MIT",
    "require": {
        "php": "8.4.* || 8.5.*",
        "guzzlehttp/psr7": "^2.4",
        "psr/http-message": "^1.0 || ^2.0",
        "ratchet/rfc6455": "^0.4",
        "react/event-loop": "^1.5",
        "react/socket": "^1.16",
        "symfony/deprecation-contracts": "^2.5 || ^3.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/routing": "^7.4 || ^8.0"
    },
    "require-dev": {
        "ext-session": "*",
        "ext-sockets": "*",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "2.1.32",
        "phpstan/phpstan-phpunit": "2.0.8",
        "phpunit/phpunit": "12.4.4",
        "psr/container": "^1.0 || ^2.0",
        "psr/event-dispatcher": "^1.0",
        "rector/rector": "2.2.9",
        "symfony/security-core": "^7.4 || ^8.0"
    },
    "conflict": {
        "psr/container": ">=3.0",
        "psr/event-dispatcher": ">=2.0"
    },
    "autoload": {
        "psr-4": {
            "BabDev\\WebSocket\\Server\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BabDev\\WebSocket\\Server\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev"
}
